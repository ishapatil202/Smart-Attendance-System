# Copy this file to .env. Do not commit the resulting .env file.
SMART_ATTENDANCE_DB_HOST=localhost
SMART_ATTENDANCE_DB_USER=root
SMART_ATTENDANCE_DB_PASSWORD=
SMART_ATTENDANCE_DB_NAME=recognition

# OpenCV camera index (normally 0 for the default webcam)
SMART_ATTENDANCE_CAMERA_INDEX=0

# SMTP settings. Leave credentials blank to keep scheduled email disabled.
SMART_ATTENDANCE_EMAIL_HOST=smtp.gmail.com
SMART_ATTENDANCE_EMAIL_PORT=587
SMART_ATTENDANCE_EMAIL_USERNAME=
SMART_ATTENDANCE_EMAIL_PASSWORD=
SMART_ATTENDANCE_EMAIL_SENDER=

# All relative paths are resolved from this repository's root.
SMART_ATTENDANCE_MODELS_DIR=models
SMART_ATTENDANCE_ANTISPOOFING_MODELS_DIR=antispoofing_models
SMART_ATTENDANCE_PHOTOS_DIR=Photos
SMART_ATTENDANCE_DATASET_DIR=dataset
SMART_ATTENDANCE_REPORTS_DIR=Attendance_Details
